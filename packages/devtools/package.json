{
	"name": "@doweljs/devtools",
	"version": "0.3.0",
	"description": "Devtools for dowel: the dependency graph and live instance state, on the Vite dev server.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/doweljs/dowel.git",
		"directory": "packages/devtools"
	},
	"homepage": "https://github.com/doweljs/dowel/tree/main/packages/devtools#readme",
	"bugs": "https://github.com/doweljs/dowel/issues",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"sideEffects": false,
	"exports": {
		".": {
			"@doweljs/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"@doweljs/source": "./src/track.ts",
			"types": "./dist/track.d.ts",
			"default": "./dist/track.js"
		}
	},
	"files": [
		"dist",
		"src",
		"ui"
	],
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json",
		"build": "rm -rf dist && tsc -p tsconfig.build.json"
	},
	"peerDependencies": {
		"@doweljs/vite": "^0.3.0",
		"@doweljs/core": "^0.3.0",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.1.1"
	},
	"devDependencies": {
		"@doweljs/vite": "^0.3.0",
		"@doweljs/core": "^0.3.0"
	}
}
