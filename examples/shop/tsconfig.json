{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		"declarationMap": false,
		"lib": ["ES2023", "ESNext.Disposable", "DOM"],
		"rootDir": "../..",
		"types": ["bun", "vite/client"],
		// The config imports the plugins' sources, which import each other: check those against sources too.
		"customConditions": ["@doweljs/source"],
		"paths": {
			"@doweljs/core": ["../../packages/dowel/src/index.ts"],
			"@doweljs/core/evolve": ["../../packages/dowel/src/evolve.ts"]
		}
	},
	"include": ["src", "test", "vite.config.ts"]
}
